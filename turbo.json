{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": {
      "persistent": false,
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/db/**",
        "drizzle.config.ts"
      ],
      "outputs": [
        "drizzle/**"
      ]
    },
    "db:migrate": {
      "persistent": false,
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "db:seed": {
      "persistent": false,
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "dev": {
      "dependsOn": ["db:migrate"],
      "persistent": true,
      "cache": false
    }
  }
}
